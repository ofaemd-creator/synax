      "    nonfinite = ${5|heal(0.0),preserve,reject,zero_output|}",
      "  }",
      "",
      "  let result = ${6:${2:a} + ${3:b}}",
      "  return result",
      "",
      "  optimize latency",
      "  target auto",
      "}"
    ]
