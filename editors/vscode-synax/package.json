{
	"name": "synax-lang",
	"displayName": "SYNAX Code — AI Pair Programmer & Autopoietic Compiler",
	"description": "Official AI Chat Assistant, Neuro-Symbolic Self-Evolution (IMMUNE + TYCON), Language Server Protocol (LSP), and SIMD compiler for SYNAX (.sx).",
	"version": "0.8.0",
	"publisher": "synaxcode",
	"author": {
		"name": "Dr. Ömer Faruk Aydın",
		"email": "dev@synaxcode.com",
		"url": "https://synaxcode.com"
	},
	"license": "Apache-2.0",
	"homepage": "https://synaxcode.org",
	"repository": {
		"type": "git",
		"url": "https://github.com/ofaemd-creator/synax.git"
	},
	"bugs": {
		"url": "https://github.com/ofaemd-creator/synax/issues",
		"email": "dev@synaxcode.com"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"*",
		"onStartupFinished",
		"onLanguage:synax",
		"onView:synax.chatView"
	],
	"categories": [
		"Programming Languages",
		"Snippets",
		"Machine Learning",
		"Other"
	],
	"keywords": [
		"synax",
		"sx",
		"ai",
		"autopoiesis",
		"chat",
		"simd",
		"neon",
		"ieee754",
		"neuro-symbolic",
		"compiler"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "synax-sidebar",
					"title": "SYNAX Code",
					"icon": "media/synax-icon.svg"
				}
			]
		},
		"views": {
			"synax-sidebar": [
				{
					"type": "webview",
					"id": "synax.chatView",
					"name": "Synax AI Chat & Autopoiesis",
					"icon": "media/synax-icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "synax.openChat",
				"title": "SYNAX Code: Chat ve Autopoiesis Panelini Aç",
				"category": "SYNAX"
			},
			{
				"command": "synax.openEvolutionArena",
				"title": "SYNAX Code: Evrim Arenası Panelini Aç",
				"category": "SYNAX"
			},
			{
				"command": "synax.teachSkill",
				"title": "SYNAX Code: Kendine Yeni Beceri Edin (Autopoiesis)",
				"category": "SYNAX"
			},
			{
				"command": "synax.evolveKernel",
				"title": "SYNAX Code: Otonom Çekirdek Evrimi (Arena: ARM64 NEON / AVX2)",
				"category": "SYNAX"
			},
			{
				"command": "synax.synthesizeFromIntent",
				"title": "SYNAX Code: Niyetten Otonom Sentezle (Neuro-Symbolic Auto-Synthesize)",
				"category": "SYNAX"
			},
			{
				"command": "synax.showArenaReport",
				"title": "SYNAX Code: Donanım Evrim Arenası Raporunu Göster",
				"category": "SYNAX"
			},
			{
				"command": "synax.toggleDreamMode",
				"title": "SYNAX Code: Boş Zaman Evrimi (Dream Mode) Başlat/Durdur",
				"category": "SYNAX"
			},
			{
				"command": "synax.compileCurrent",
				"title": "SYNAX Code: Aktif Dosyayı Derle (Compile)",
				"category": "SYNAX"
			},
			{
				"command": "synax.checkCurrent",
				"title": "SYNAX Code: Tip ve Güvenlik Denetimi (Check)",
				"category": "SYNAX"
			},
			{
				"command": "synax.reconnectBackend",
				"title": "Yeniden Bağlan / Bağlantıyı Yenile",
				"category": "SYNAX",
				"icon": "$(sync)"
			},
			{
				"command": "synax.disconnectBackend",
				"title": "Bağlantıyı Kes",
				"category": "SYNAX",
				"icon": "$(debug-disconnect)"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "synax.reconnectBackend",
					"when": "view == synax.chatView",
					"group": "navigation@1"
				},
				{
					"command": "synax.disconnectBackend",
					"when": "view == synax.chatView",
					"group": "navigation@2"
				}
			]
		},
		"languages": [
			{
				"id": "synax",
				"aliases": [
					"SYNAX",
					"synax",
					"Synax (.sx)"
				],
				"extensions": [
					".sx"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "synax",
				"scopeName": "source.synax",
				"path": "./syntaxes/synax.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "synax",
				"path": "./snippets/synax.code-snippets"
			}
		],
		"configuration": {
			"title": "SYNAX Code & Language Server",
			"properties": {
				"synax.lsp.enable": {
					"type": "boolean",
					"default": true,
					"description": "Enable real-time SYNAX Language Server Protocol (LSP) diagnostics, hover, and CodeLens."
				},
				"synax.lsp.executable": {
					"type": "string",
					"default": "synax",
					"description": "Path to the synax CLI executable (executes 'synax lsp' on stdio)."
				},
				"synax.chat.scriptPath": {
					"type": "string",
					"default": "",
					"description": "Custom path to synax_chat.py (auto-detected if empty)."
				},
				"synax.chat.pythonPath": {
					"type": "string",
					"default": "",
					"description": "Custom path to Python 3 interpreter used by Synax AI Chat."
				},
				"synax.evolution.dreamMode": {
					"type": "boolean",
					"default": true,
					"description": "Enable idle-time background optimization when inactive for 30 seconds."
				},
				"synax.llm.modelPath": {
					"type": "string",
					"default": "",
					"scope": "machine-overridable",
					"description": "Directory containing your own SynaxLLM config.json and weights.pt. No external model API is called. Reconnect after changing."
				}
			}
		}
	},
	"__metadata": {
		"installedTimestamp": 1793952063767,
		"targetPlatform": "undefined",
		"size": 726586
	}
}