synax 0.5

kernel my_perfusion(
  a: tensor<f32>,
  b: tensor<f32>
) -> tensor<f32> {
  intent "my_perfusion: Otonom öğrenilmiş nöro-sembolik hesaplama becerisi."

  require shape(a) == shape(b)

  safety {
    nonfinite = heal(0.0)
    range_check = clamp(-1000.0, 1000.0)
  }

  let result = (a + b) * bias
  return result

  optimize latency
  target auto
}
